# Postgres. Locally: the compose `db` service (`docker compose up db`).
# On Vercel the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED
# (direct; used for migrations). Neon's strings can be pasted as-is.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/world_data

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=<random-32-bytes>
AUTH_GOOGLE_ID=<google-oauth-client-id>
AUTH_GOOGLE_SECRET=<google-oauth-client-secret>
# Local only: one-click "Dev login" as a demo user, no Google needed. Ignored outside `next dev`.
# AUTH_DEV_LOGIN=true
# Only for self-hosting behind a proxy in production (not needed locally or on Vercel).
# AUTH_TRUST_HOST=true

# World Bank API v2 base URL (optional; defaults to https://api.worldbank.org/v2)
WORLD_BANK_API_URL=https://api.worldbank.org/v2
# How long a page waits for the World Bank before showing "try again" (ms, default 15000).
WORLD_BANK_TIMEOUT_MS=15000
