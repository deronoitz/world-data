{
  "name": "world-data",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm geo && next dev",
    "build": "pnpm geo && next build",
    "vercel-build": "pnpm db:migrate && pnpm build",
    "start": "next start",
    "lint": "eslint",
    "geo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-geo.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "i18n-iso-countries": "^7.14.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.26.0"
}
